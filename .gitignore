*.log

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Durable worker state is environment-specific; commit reproducible runners and reports instead.
checkpoints/

# Secrets (NEVER commit these)
.env
.secrets
*.pem
*.key

# Research outputs
research/*.pdf
research/*.png
web/node_modules/
web/dist/

# Large local-only model checkpoints are retained by the v14 run metadata and
# digests; GitHub source releases contain the reproducible code and evidence,
# not binary weights exceeding hosted-repository file limits.
reports/v14/*/checkpoint-latest.pt
# The v15 native instruction-tuning checkpoint is likewise local-only; its
# source, manifests, metric records, and documented size remain publishable.
reports/v15/*/checkpoint-latest.pt
